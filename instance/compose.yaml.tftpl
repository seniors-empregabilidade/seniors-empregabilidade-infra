# Um serviço só. O TLS morre no CloudFront, então não há proxy aqui — a
# aplicação publica direto na 80, e quem protege é o security group.
services:
  api:
    image: ${ecr_repo}:$${IMAGE_TAG}
    restart: unless-stopped
    ports:
      - "80:8000"
    env_file:
      - /opt/seniors/api.env
    logging:
      driver: awslogs
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: api
